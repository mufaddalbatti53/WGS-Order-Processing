# ============================================================
# WGS Order Processing — Environment Variables
# Copy this to .env and fill in your real values
# ============================================================

PORT=3001
NODE_ENV=production
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
FRONTEND_URL=https://your-frontend-url.com

# MongoDB Atlas Connection String
# Get from: cloud.mongodb.com → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/wgs_orders?retryWrites=true&w=majority

# Gmail SMTP (generate App Password at myaccount.google.com > Security > App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME=WGS Order Processing
SMTP_FROM_EMAIL=your_gmail@gmail.com

# MSG91 SMS (sign up free at msg91.com)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=WGSORD
MSG91_TEMPLATE_ID=your_template_id
SMS_ENABLED=false

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-render-url.onrender.com/api/auth/google/callback

# OTP expires after this many minutes
OTP_EXPIRE_MINUTES=10
