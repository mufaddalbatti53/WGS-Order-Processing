# ============================================================
# WGS Order Processing — Environment Variables
# Copy this to .env and fill in your real values
# ============================================================

PORT=3001
NODE_ENV=production
JWT_SECRET=abcdefghijklmnopqrstuvwxyz1234567890
FRONTEND_URL=https://wgs-order-processor.netlify.app/

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/WGSOrderProcessing?appName=Cluster0

# ============================================================
# GMAIL SMTP  —  FIX APPLIED
# Port 587 uses STARTTLS (SMTP_SECURE must be FALSE)
# Port 465 uses SSL    (SMTP_SECURE must be TRUE)
# Your current config had port 587 + SMTP_SECURE=TRUE → that's wrong and breaks OTP emails.
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # ← MUST be false for port 587
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password   # Google account → Security → App Passwords
SMTP_FROM_NAME=WGS Order Processing
SMTP_FROM_EMAIL=you@gmail.com

# OTP expires after this many minutes
OTP_EXPIRE_MINUTES=10

# ============================================================
# WHATSAPP — Meta Cloud API (free tier available)
# Steps:
#   1. Go to https://developers.facebook.com → Create App → Business
#   2. Add "WhatsApp" product
#   3. Get your Phone Number ID from WhatsApp > Getting Started
#   4. Generate a permanent token (System User token recommended)
#   5. The sender number is the one you register in Meta — make sure
#      it matches the manager's WhatsApp number from registration.
# ============================================================
WA_PHONE_NUMBER_ID=your_meta_phone_number_id
WA_ACCESS_TOKEN=your_meta_permanent_access_token

# ============================================================
# GOOGLE DRIVE BACKUP (Service Account — recommended)
# Steps:
#   1. console.cloud.google.com → IAM → Service Accounts → Create
#   2. Download JSON key → save as service-account.json in project root
#   3. Go to your Drive folder → Share it with the service account email
#   4. Copy the folder ID from the URL: drive.google.com/drive/folders/FOLDER_ID_HERE
# Option A: point to the key file path
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# Option B: paste the JSON contents as a single line (for cloud deployments like Render)
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account","project_id":"..."}

# Google Drive folder where backups are saved (optional — saves to root if omitted)
GOOGLE_DRIVE_BACKUP_FOLDER_ID=your_drive_folder_id_here

# ============================================================
# GOOGLE OAUTH (for staff login with Google)
# ============================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=https://your-render-url.onrender.com/api/auth/google/callback

# ============================================================
# MSG91 SMS (optional — WhatsApp replaces SMS now)
# ============================================================
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=WGSORD
MSG91_TEMPLATE_ID=your_template_id
SMS_ENABLED=false
